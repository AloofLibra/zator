#!/bin/sh /etc/rc.common

USE_PROCD=1
START=19
STOP=89

ZATOR_ROOT="${ZATOR_ROOT:-/opt/zator}"
SHADOW_ENABLED="$ZATOR_ROOT/extra_strats/cache/adaptive-shadow.enabled"
LEARNING_ENABLED="$ZATOR_ROOT/extra_strats/cache/adaptive-learning.enabled"
CANARY_ENABLED="$ZATOR_ROOT/extra_strats/cache/adaptive-canary.enabled"
CANARY_HOSTS="$ZATOR_ROOT/extra_strats/cache/adaptive-canary.hosts"
BIN="$ZATOR_ROOT/adaptive/bin/adaptive-controller"
NFQWS2="${ZAPRET2_ROOT:-/opt/zapret2}/nfq2/nfqws2"
RUNDIR=/tmp/zator-adaptive
SOCKET="$RUNDIR/events.sock"
OUTPUT="$RUNDIR/shadow.tsv"
STATE="$RUNDIR/state.tsv"
SCHEDULER="$ZATOR_ROOT/adaptive/scheduler-loop.sh"

start_service()
{
	[ -f "$SHADOW_ENABLED" ] || [ -f "$LEARNING_ENABLED" ] || [ -f "$CANARY_ENABLED" ] || return 0
	[ -x "$BIN" ] || { echo "adaptive-controller binary is missing" >&2; return 1; }
	[ -x "$NFQWS2" ] || return 0
	"$NFQWS2" --help 2>&1 | grep -q -- '--adaptive-events=<file|unix:path>' || return 0
	if [ -f "$CANARY_ENABLED" ]; then
		[ -r "$CANARY_HOSTS" ] || { echo "Canary host allowlist is missing." >&2; return 1; }
		"$NFQWS2" --help 2>&1 | grep -q -- '--adaptive-control=<unix_path>' &&
		"$NFQWS2" --help 2>&1 | grep -q -- '--adaptive-canary-profile=<profile>' || {
			echo "nfqws2 canary support is unavailable" >&2; return 1;
		}
	fi
	[ ! -L "$RUNDIR" ] || { echo "refusing symlink runtime directory" >&2; return 1; }
	mkdir -p "$RUNDIR" || return 1
	[ -d "$RUNDIR" ] && [ ! -L "$RUNDIR" ] || return 1
	chmod 700 "$RUNDIR" || return 1
	procd_open_instance
	procd_set_param command "$BIN" --socket "$SOCKET" --output "$OUTPUT" --state "$STATE"
	if [ -f "$CANARY_ENABLED" ]; then
		procd_append_param command --canary-control /tmp/zator-adaptive/production-control.sock \
			--canary-profile 1 --canary-hosts "$CANARY_HOSTS"
	fi
	procd_set_param respawn 3600 5 5
	procd_set_param stderr 1
	procd_close_instance
	if [ -f "$LEARNING_ENABLED" ] && [ -x "$SCHEDULER" ]; then
		procd_open_instance scheduler
		procd_set_param command /bin/sh "$SCHEDULER"
		procd_set_param respawn 3600 5 5
		procd_close_instance
	fi
}
