#!/bin/sh /etc/rc.common
# zapret2-watchdog : перезапускает zapret2, если nfqws2 УПАЛ или задыхается по памяти.
#
# Отличие падения от намеренной остановки:
#   - штатный stop (init-скрипт) удаляет pidfile (/var/run/nfqws2_*.pid) —
#     watchdog видит "нет pidfile, нет процесса" и НЕ трогает zapret2;
#   - падение оставляет pidfile с мёртвым pid — watchdog перезапускает.
#   Поэтому выключение/остановка/обновление zapret2 пользователем не вызывают
#   автоматического перезапуска.
#
# Причины перезапуска:
#   - pidfile есть, но процесс мёртв (демон упал)
#   - в syslog (logread) появились НОВЫЕ строки LUA PANIC / not enough memory
#     от nfqws2 — на OpenWRT stderr демона идёт в syslog
#     (procd_set_param stderr 1 в wrt_fixes), а не в /tmp/nfqws2_*.err
#   - (опционально) RSS процесса превысил лимит
# Если init-скрипт zapret2 исчез (удаление) — watchdog сам останавливается.
# procd дополнительно поднимет сам watchdog, если тот умрёт (respawn 3600 5 5).
#
# Лог событий: /tmp/zapret2-watchdog.log (+ syslog через logger).
# Конфиг (не обязателен, применяется на лету):
#   /opt/zator/z2r_lib/zapret2-watchdog.conf
#   WATCH_INTERVAL=30        # период проверки, сек
#   WATCH_MEM_LIMIT_KB=0     # лимит RSS в KB, 0 = выключено
#   WATCH_COOLDOWN=60        # минимум секунд между перезапусками

USE_PROCD=1
START=98

# Пути можно переопределить через env (используется smoke-тестами)
CONF="${Z2R_WATCHDOG_CONF:-/opt/zator/z2r_lib/zapret2-watchdog.conf}"
LOGFILE="${Z2R_WATCHDOG_LOGFILE:-/tmp/zapret2-watchdog.log}"
RUNDIR="${Z2R_WATCHDOG_RUNDIR:-/var/run}"

WATCH_INTERVAL=30
WATCH_MEM_LIMIT_KB=0
WATCH_COOLDOWN=60

[ -f "$CONF" ] && . "$CONF"

my_extra_command() {
	local cmd="$1"
	local help="$2"
	local extra="$(printf "%-16s%s" "${cmd}" "${help}")"
	EXTRA_HELP="${EXTRA_HELP:-}	${extra}
"
	EXTRA_COMMANDS="${EXTRA_COMMANDS:-} ${cmd}"
}
my_extra_command run "internal: run watchdog loop"

watch_init()
{
	if [ -n "$WATCH_INIT_CMD" ]; then
		WATCH_INIT=$WATCH_INIT_CMD
	elif [ -x /opt/etc/init.d/S90-zapret2 ]; then
		WATCH_INIT=/opt/etc/init.d/S90-zapret2
	elif [ -x /etc/init.d/zapret2 ]; then
		WATCH_INIT=/etc/init.d/zapret2
	else
		return 1
	fi
}

wlog()
{
	# /tmp доступен всем на запись: не пишем в симлинк, подменённый
	# локальным пользователем
	[ -L "$LOGFILE" ] && rm -f "$LOGFILE"
	echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >>"$LOGFILE"
	logger -t zapret2-watchdog "$*" 2>/dev/null || :
	# не даём логу расти бесконечно
	if [ "$(wc -c <"$LOGFILE" 2>/dev/null || echo 0)" -gt 51200 ]; then
		rm -f "$LOGFILE.tmp"
		tail -n 200 "$LOGFILE" >"$LOGFILE.tmp" 2>/dev/null && mv -f "$LOGFILE.tmp" "$LOGFILE"
	fi
}

is_nfqws2_pid()
{
	# существование /proc/$1 не доказывает, что pid принадлежит nfqws2:
	# после падения и переиспользования pid устаревший pidfile должен
	# считаться падением, а не «работает». Сверяем аргументы процесса.
	[ -n "$1" ] || return 1
	case "$1" in *[!0-9]*) return 1 ;; esac
	[ -r "/proc/$1/cmdline" ] || return 1
	tr '\0' '\n' <"/proc/$1/cmdline" 2>/dev/null | grep -qE '(^|/)nfqws2$'
}

nfqws2_state()
{
	# выводит: "run <pids>" | "crash" | "stopped" | "deadpid <pidfile>"
	pidfiles=""
	live_pids=""
	dead_pf=""
	for pf in "$RUNDIR"/nfqws2_*.pid; do
		[ -r "$pf" ] || continue
		pidfiles=yes
		p=$(cat "$pf" 2>/dev/null)
		if is_nfqws2_pid "$p"; then
			live_pids="$live_pids $p"
		else
			dead_pf=$pf
		fi
	done
	if [ -n "$live_pids" ]; then
		if [ -n "$dead_pf" ]; then
			echo "deadpid $dead_pf"
		else
			echo "run$live_pids"
		fi
		return
	fi
	# pidfile мог потеряться — ищем процесс по имени
	byname=$(pidof nfqws2 2>/dev/null)
	if [ -n "$byname" ]; then
		echo "run $byname"
		return
	fi
	# процесса нет: pidfile остался = упал, pidfile удалён = штатная остановка
	if [ -n "$pidfiles" ]; then
		echo "crash"
	else
		echo "stopped"
	fi
}

oom_scan()
{
	# Курсор syslog: OOM_CURSOR хранит последнюю уже обработанную строку
	# буфера, новыми считаются строки ПОСЛЕ её последнего вхождения. Счётчик
	# количества здесь не годится: кольцевой буфер может вытеснить одну
	# старую OOM-строку ровно в момент появления новой — количество не
	# меняется и новый OOM терялся. Если курсора в буфере уже нет (вытеснен
	# или лог обнулён) — новыми считаются все текущие строки: они
	# гарантированно появились позже курсора (буфер вытесняет старейшие
	# первыми). Пустой курсор (первый запуск) — всё считается старым, чтобы
	# не сработать на истории до старта watchdog.
	OOM_NEW_MATCH=0
	local out
	out=$(logread 2>/dev/null | awk -v marker="$OOM_CURSOR" '
		BEGIN { n = 0; matches = 0; start = ""; last = "" }
		{
			last = $0
			lines[++n] = $0
			if (marker != "" && $0 == marker) { start = n }
		}
		END {
			if (marker == "") {
				# первый запуск: историю до старта watchdog пропускаем
				start = n
			} else if (start == "") {
				# курсора в буфере нет (вытеснен или лог обнулён) —
				# все текущие строки появились позже курсора
				start = 0
			}
			for (i = start + 1; i <= n; i++)
				if (tolower(lines[i]) ~ /nfqws2.*(lua panic|not enough memory|out of memory)/)
					matches++
			print matches
			print last
		}')
	OOM_NEW_MATCH=$(printf '%s\n' "$out" | sed -n 1p)
	OOM_CURSOR=$(printf '%s\n' "$out" | sed -n 2p)
	[ -n "$OOM_NEW_MATCH" ] || OOM_NEW_MATCH=0
}

do_restart()
{
	now=$(date +%s)
	if [ $((now - LAST_RESTART)) -lt "$WATCH_COOLDOWN" ]; then
		wlog "перезапуск пропущен (cooldown): $1"
		return
	fi
	LAST_RESTART=$now
	wlog "ПАДЕНИЕ/ПРОБЛЕМА, перезапускаю zapret2: $1"
	# снимок памяти до рестарта: видно, был ли это действительно OOM
	memline=$(free 2>/dev/null | grep '^Mem:' || :)
	[ -n "$memline" ] && wlog "память до рестарта: $(echo "$memline" | tr -s ' \t' ' ')"
	# вывод init не пишем: ошибки nfqws2 видны в syslog (logread | grep nfqws2)
	if "$WATCH_INIT" restart >/dev/null 2>&1; then
		wlog "рестарт zapret2 выполнен"
	else
		wlog "рестарт zapret2 завершился с ошибкой — подробности в syslog (logread | grep nfqws2)"
	fi
}

do_watch()
{
	watch_init || { wlog "init-скрипт zapret2 не найден, watchdog останавливается"; exit 1; }
	LAST_RESTART=0
	LAST_STATE=""
	# пустой курсор: история syslog до старта watchdog триггером не станет
	OOM_CURSOR=""
	wlog "watchdog запущен (interval=${WATCH_INTERVAL}s, mem_limit=${WATCH_MEM_LIMIT_KB}KB, init=$WATCH_INIT)"
	trap 'wlog "watchdog остановлен"; exit 0' TERM INT

	while :; do
		sleep "$WATCH_INTERVAL"

		# удаление zapret2: init-скрипт исчез — нам тут больше делать нечего
		if [ ! -x "$WATCH_INIT" ]; then
			wlog "init-скрипт zapret2 исчез (удаление?), watchdog останавливается"
			exit 0
		fi

		# конфиг можно менять на лету
		[ -f "$CONF" ] && . "$CONF"
		: "${WATCH_INTERVAL:=30}"

		reason=""
		state=$(nfqws2_state)

		case "$state" in
		run*)
			if [ "$LAST_STATE" != run ]; then
				wlog "nfqws2 работает (pids:${state#run})"
			fi
			;;
		crash)
			reason="nfqws2 упал (pidfile остался с мёртвым pid)"
			;;
		deadpid*)
			reason="часть демонов не жива ($state)"
			;;
		stopped)
			if [ "$LAST_STATE" != stopped ]; then
				wlog "nfqws2 не запущен (штатная остановка или ещё не стартовал) — перезапуск не требуется"
			fi
			;;
		esac
		LAST_STATE=${state%% *}

		# курсор syslog двигаем каждый цикл, даже пока nfqws2 остановлен,
		# иначе после простоя старые строки считались бы новыми
		oom_scan
		# живой, но задыхающийся: новые маркеры нехватки памяти в syslog
		if [ -z "$reason" ] && [ "$LAST_STATE" = run ] && [ "$OOM_NEW_MATCH" -gt 0 ]; then
			reason="нехватка памяти (новый маркер OOM в syslog)"
		fi

		# опциональный лимит RSS (только для живого процесса)
		if [ -z "$reason" ] && [ "$LAST_STATE" = run ] && [ "$WATCH_MEM_LIMIT_KB" -gt 0 ] 2>/dev/null; then
			rss=0
			for p in ${state#run}; do
				v=$(awk '/^VmRSS:/{print $2}' "/proc/$p/status" 2>/dev/null)
				[ -n "$v" ] && rss=$((rss + v))
			done
			if [ "$rss" -gt "$WATCH_MEM_LIMIT_KB" ] 2>/dev/null; then
				reason="RSS ${rss}KB выше лимита ${WATCH_MEM_LIMIT_KB}KB"
			fi
		fi

		[ -n "$reason" ] && do_restart "$reason"
	done
}

run()
{
	do_watch
}

start_service()
{
	watch_init || { echo "init-скрипт zapret2 не найден" >&2; return 1; }
	procd_open_instance
	# НЕ $0: под «#!/bin/sh /etc/rc.common» $0 указывает на /etc/rc.common,
	# реальный путь init-скрипта даёт $initscript (его выставляет rc.common)
	procd_set_param command "$initscript" run
	procd_set_param respawn 3600 5 5
	procd_close_instance
}
