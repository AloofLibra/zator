+	return false;
+}
+
+static bool adaptive_parse_uint32(const char **cursor, char delimiter, uint32_t *value)
+{
+	const char *p = *cursor;
+	uint32_t v = 0;
+	if (!*p || *p < '0' || *p > '9') return false;
+	while (*p >= '0' && *p <= '9') {
+		unsigned digit = (unsigned)(*p - '0');
+		if (v > (UINT32_MAX - digit) / 10) return false;
+		v = v * 10 + digit;
+		p++;
+	}
+	if (*p != delimiter) return false;
+	*value = v;
+	*cursor = p + 1;
+	return true;
+}
