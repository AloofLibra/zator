+            except Exception:
+                self.send_json(503, {"ok": False, "error": "recommendations unavailable"})
+                return
+            self.send_response(200)
+            self.send_header("content-type", "text/tab-separated-values; charset=utf-8")
+            self.send_header("content-length", str(len(body)))
