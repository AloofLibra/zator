     def do_GET(self):
         parsed = urlparse(self.path)
         params = parse_qs(parsed.query)
+        if parsed.path == "/recommendations.tsv":
+            providers = parse_qs(parsed.query, keep_blank_values=True).get("provider", [])
+            try:
+                if len(providers) != 1:
+                    raise ValueError("invalid provider")
+                provider = validate_provider(providers[0])
+            except ValueError:
+                self.send_json(400, {"ok": False, "error": "invalid provider"})
+                return
+            try:
+                global RECOMMENDATION_ALIASES
