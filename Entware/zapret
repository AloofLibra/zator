#!/bin/sh
### BEGIN INIT INFO
# Provides:		zapret
# Required-Start:	$local_fs $network
# Required-Stop:	$local_fs $network
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

SCRIPT=$(readlink -f "$0")
EXEDIR=$(dirname "$SCRIPT")
ZAPRET_BASE=$(readlink -f "$EXEDIR/../..")
. "$EXEDIR/functions"

# z2r: оверрайды апстримных contains и run_daemon — см. AGENTS.md (High-Risk Areas).
contains()
{
	case "$1" in
		*"$2"*) return 0 ;;
	esac
	return 1
}

# z2r: оверрайд run_daemon — см. AGENTS.md (High-Risk Areas).
# z2r: bind-fix (SO_BINDTODEVICE для сгенерированных пакетов) нужен только при
# активном PBR. При одном провайдере это лишний setsockopt на каждый rawsend,
# поэтому решение принимается здесь, на старте демона, а не записывается в конфиг.
z2r_pbr_active()
{
	local wan_n
	# IFACE_WAN уже развёрнут шеллом из конфига (functions его source-ит).
	set -- $IFACE_WAN
	wan_n=$#
	[ "$wan_n" -ge 2 ] && return 0
	if command -v ndmc >/dev/null 2>&1 && ndmc -c "show ip policy" 2>/dev/null | grep -q 'mark:'; then
		return 0
	fi
	if command -v ip >/dev/null 2>&1; then
		ip -4 rule show 2>/dev/null | grep -q 'fwmark' && return 0
		ip -6 rule show 2>/dev/null | grep -q 'fwmark' && return 0
	fi
	return 1
}

# Аргументы nfqws2 с префиксом --bind-fix4/--bind-fix6 по режиму
# Z2R_KEENETIC_BINDFIX: auto (только при PBR), 1 (всегда), 0 (никогда).
# Глобальные опции обязаны идти до первого профиля/--new, поэтому префикс.
z2r_bindfix_args()
{
	local args="$1"

	case "${Z2R_KEENETIC_BINDFIX:-auto}" in
		0|off|no) printf '%s\n' "$args"; return 0 ;;
		1|on|yes) ;;
		*) z2r_pbr_active || { printf '%s\n' "$args"; return 0; } ;;
	esac
	case " $args " in
		*" --bind-fix4 "*) printf '%s\n' "$args"; return 0 ;;
	esac
	if [ -z "$args" ]; then
		printf '%s\n' "--bind-fix4 --bind-fix6"
	else
		printf '%s\n' "--bind-fix4 --bind-fix6 $args"
	fi
}

run_daemon()
{
	# $1 - daemon number : 1,2,3,...
	# $2 - daemon
	# $3 - daemon args
	local DAEMONBASE="$(basename "$2")"
	local PID= PIDFILE=$PIDDIR/${DAEMONBASE}_$1.pid
	local DAEMONARGS="$3"
	case "$DAEMONBASE" in
		*nfqws2) DAEMONARGS="$(z2r_bindfix_args "$DAEMONARGS")" ;;
	esac
	echo "Starting daemon $1: $2 $DAEMONARGS"

	[ -f "$PIDFILE" ] && {
		read PID <"$PIDFILE"
		[ -d "/proc/$PID" ] || PID=
	}

	if [ -n "$PID" ]; then
		echo already running
	else
		ERRLOG="/tmp/${DAEMONBASE}_$1.err"
		: > "$ERRLOG"
		if command -v setsid >/dev/null 2>&1; then
			setsid "$2" $DAEMONARGS </dev/null >/dev/null 2>>"$ERRLOG" &
			PID=$!
		elif [ -t 0 ]; then
			# job control даёт фону свою группу процессов (защита от Ctrl+C в
			# интерактивном меню), но требует ЖИВОЙ управляющий терминал:
			# под uhttpd/CGI с мёртвым pty (панель поднята nohup'ом из уже
			# закрытой SSH-сессии) busybox ash уходит в вечный спин на set -m
			set -m 2>/dev/null
			"$2" $DAEMONARGS </dev/null >/dev/null 2>>"$ERRLOG" &
			PID=$!
			set +m 2>/dev/null
		else
			"$2" $DAEMONARGS </dev/null >/dev/null 2>>"$ERRLOG" &
			PID=$!
		fi
		if [ -n "$PID" ]; then
			echo $PID >$PIDFILE
		else
			echo could not start daemon $1 : $2 $DAEMONARGS
			false
		fi
	fi
}

NAME=zapret
DESC=anti-zapret

# z2r: модули ядра ищем в обоих местах KeeneticOS. На NDMS 5.1.x они переехали
# в /lib/system-modules/<kver>, а /lib/modules/<kver> остаётся почти пустым —
# прежний insmod по одному пути молча проваливался и на xt_connbytes убивал
# старт через exit 1, оставляя роутер без правил. Каталоги переопределяемы
# (тесты): Z2R_MODULE_DIRS.
Z2R_MODULE_DIRS="${Z2R_MODULE_DIRS:-/lib/modules/$(uname -r) /lib/system-modules/$(uname -r) /lib/system-modules}"
Z2R_IPT_TARGETS="${Z2R_IPT_TARGETS:-/proc/net/ip_tables_targets}"

z2r_module_loaded()
{
	lsmod 2>/dev/null | grep -q "^$1 "
}

# $1 - имя модуля (xt_connbytes). 0 = загружен или уже был загружен.
# Ничего не считаем фатальным: без модуля не встанут его правила, но роутер
# останется в сети (NFQUEUE ставится с --queue-bypass).
z2r_load_module()
{
	local name="$1" dir path
	z2r_module_loaded "$name" && { echo "$name.ko is already loaded"; return 0; }
	for dir in $Z2R_MODULE_DIRS; do
		[ -d "$dir" ] || continue
		path="$dir/$name.ko"
		[ -f "$path" ] || path="$(ls "$dir/$name".ko* 2>/dev/null | head -n 1)"
		[ -n "$path" ] && [ -f "$path" ] || continue
		if insmod "$path" >/dev/null 2>&1; then
			echo "$name.ko loaded"
			return 0
		fi
	done
	if command -v modprobe >/dev/null 2>&1 && modprobe -q "$name" >/dev/null 2>&1; then
		echo "$name.ko loaded"
		return 0
	fi
	return 1
}

do_start()
{
	if ! z2r_load_module xt_multiport; then
		echo -e "\033[0;31mCannot find xt_multiport.ko kernel module, this make some problems. Or not.\033[0m"
	fi
	if ! z2r_load_module xt_connbytes; then
		echo -e "\033[0;31mCannot find xt_connbytes.ko: правила -m connbytes не встанут. Проверьте /lib/system-modules.\033[0m"
	fi
	if ! z2r_load_module xt_NFQUEUE; then
		echo -e "\033[0;31mCannot find xt_NFQUEUE.ko: NFQUEUE недоступен, обход работать не будет.\033[0m"
	fi
	z2r_load_module xt_CONNMARK || z2r_load_module xt_connmark || true
	z2r_load_module nfnetlink_queue || true

	if [ -r "$Z2R_IPT_TARGETS" ] && ! grep -qw CONNMARK "$Z2R_IPT_TARGETS"; then
		echo -e "\033[0;31mCONNMARK target is not available: правило FILTER_TTL_EXPIRED_ICMP не установится.\033[0m"
	fi

	zapret_run_daemons
	[ "$INIT_APPLY_FW" != "1" ] || { zapret_apply_firewall; }
}
do_stop()
{
	zapret_stop_daemons
	[ "$INIT_APPLY_FW" != "1" ] || zapret_unapply_firewall
}

case "$1" in
	start)
		do_start
		;;

	stop)
		do_stop
		;;

	restart)
		do_stop
		do_start
		;;

	start-fw|start_fw)
		zapret_apply_firewall
		;;
	stop-fw|stop_fw)
		zapret_unapply_firewall
		;;

	restart-fw|restart_fw)
		zapret_unapply_firewall
		zapret_apply_firewall
		;;
	
	start-daemons|start_daemons)
		zapret_run_daemons
		;;
	stop-daemons|stop_daemons)
		zapret_stop_daemons
		;;
	restart-daemons|restart_daemons)
		zapret_stop_daemons
		zapret_run_daemons
		;;

	reload-ifsets|reload_ifsets)	
		zapret_reload_ifsets
		;;
	list-ifsets|list_ifsets)	
		zapret_list_ifsets
		;;
	list-table|list_table)	
		zapret_list_table
		;;
		
  *)
	N=/etc/init.d/$NAME
	echo "Usage: $N {start|stop|restart|start-fw|stop-fw|restart-fw|start-daemons|stop-daemons|restart-daemons|reload-ifsets|list-ifsets|list-table}" >&2
	exit 1
	;;
esac

exit 0
