#!/bin/sh

ZATOR_ROOT="${ZATOR_ROOT:-/opt/zator}"
SHADOW_ENABLED="$ZATOR_ROOT/extra_strats/cache/adaptive-shadow.enabled"
LEARNING_ENABLED="$ZATOR_ROOT/extra_strats/cache/adaptive-learning.enabled"
CANARY_ENABLED="$ZATOR_ROOT/extra_strats/cache/adaptive-canary.enabled"
CANARY_HOSTS="$ZATOR_ROOT/extra_strats/cache/adaptive-canary.hosts"
BIN="$ZATOR_ROOT/adaptive/bin/adaptive-controller"
NFQWS2="${ZAPRET2_ROOT:-/opt/zapret2}/nfq2/nfqws2"
RUNDIR=/tmp/zator-adaptive
SOCKET="$RUNDIR/events.sock"
OUTPUT="$RUNDIR/shadow.tsv"
ERRLOG="$RUNDIR/controller.err"
STATE="$RUNDIR/state.tsv"
PIDFILE="${Z2R_ADAPTIVE_PIDFILE:-/opt/var/run/z2r-adaptive-controller.pid}"
SCHEDULER="$ZATOR_ROOT/adaptive/scheduler-loop.sh"
SCHEDULER_PIDFILE="${Z2R_ADAPTIVE_SCHEDULER_PIDFILE:-/opt/var/run/z2r-adaptive-scheduler.pid}"

controller_pid_valid()
{
	[ -r "$PIDFILE" ] || return 1
	pid=$(cat "$PIDFILE" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ -r "/proc/$pid/cmdline" ] || return 1
	first=$(tr '\000' '\n' <"/proc/$pid/cmdline" 2>/dev/null | sed -n '1p')
	[ "$first" = "$BIN" ]
}

scheduler_pid_valid()
{
	[ -r "$SCHEDULER_PIDFILE" ] || return 1
	pid=$(cat "$SCHEDULER_PIDFILE" 2>/dev/null)
	case "$pid" in ''|*[!0-9]*) return 1 ;; esac
	[ -r "/proc/$pid/cmdline" ] || return 1
	args=$(tr '\000' '\n' <"/proc/$pid/cmdline" 2>/dev/null)
	first=$(printf '%s\n' "$args" | sed -n '1p')
	second=$(printf '%s\n' "$args" | sed -n '2p')
	[ "$first" = /bin/sh ] && [ "$second" = "$SCHEDULER" ]
}

start_scheduler()
{
	[ -f "$LEARNING_ENABLED" ] || { stop_scheduler; return 0; }
	[ -x "$SCHEDULER" ] || { echo "Не установлен adaptive scheduler runner." >&2; return 1; }
	if scheduler_pid_valid; then return 0; fi
	rm -f "$SCHEDULER_PIDFILE"
	/bin/sh "$SCHEDULER" </dev/null >/dev/null 2>&1 &
	pid=$!
	sleep 1
	kill -0 "$pid" 2>/dev/null || { echo "Adaptive scheduler не запустился." >&2; return 1; }
	printf '%s\n' "$pid" >"$SCHEDULER_PIDFILE" || return 1
	chmod 600 "$SCHEDULER_PIDFILE" 2>/dev/null || :
}

stop_scheduler()
{
	if scheduler_pid_valid; then
		pid=$(cat "$SCHEDULER_PIDFILE")
		kill -TERM "$pid" 2>/dev/null || :
		i=0
		while [ "$i" -lt 180 ] && kill -0 "$pid" 2>/dev/null; do
			sleep 1
			i=$((i + 1))
		done
		if kill -0 "$pid" 2>/dev/null; then kill -KILL "$pid" 2>/dev/null || :; fi
	fi
	rm -f "$SCHEDULER_PIDFILE"
}

start_controller()
{
	[ -f "$SHADOW_ENABLED" ] || [ -f "$LEARNING_ENABLED" ] || [ -f "$CANARY_ENABLED" ] || { echo "Adaptive режим выключен."; return 0; }
	[ -x "$BIN" ] || { echo "Не установлен adaptive-controller."; return 1; }
	[ -x "$NFQWS2" ] || return 0
	"$NFQWS2" --help 2>&1 | grep -q -- '--adaptive-events=<file|unix:path>' || return 0
	if [ -f "$CANARY_ENABLED" ]; then
		[ -r "$CANARY_HOSTS" ] || { echo "Canary host allowlist is missing." >&2; return 1; }
		"$NFQWS2" --help 2>&1 | grep -q -- '--adaptive-control=<unix_path>' &&
		"$NFQWS2" --help 2>&1 | grep -q -- '--adaptive-canary-profile=<profile>' || {
			echo "Установленный nfqws2 не поддерживает canary endpoint." >&2; return 1;
		}
	fi
	if controller_pid_valid; then
		start_scheduler || return 1
		echo "Adaptive Controller уже запущен."
		return 0
	fi
	rm -f "$PIDFILE"
	[ ! -L "$RUNDIR" ] || { echo "refusing symlink runtime directory" >&2; return 1; }
	mkdir -p "$RUNDIR" "$(dirname "$PIDFILE")" || return 1
	[ -d "$RUNDIR" ] && [ ! -L "$RUNDIR" ] || return 1
	chmod 700 "$RUNDIR" || return 1
	[ ! -L "$ERRLOG" ] || { echo "refusing symlink controller error log" >&2; return 1; }
	: >"$ERRLOG" || return 1
	chmod 600 "$ERRLOG" || return 1
	set -- "$BIN" --socket "$SOCKET" --output "$OUTPUT" --state "$STATE"
	if [ -f "$CANARY_ENABLED" ]; then
		set -- "$@" --canary-control /tmp/zator-adaptive/production-control.sock \
			--canary-profile 1 --canary-hosts "$CANARY_HOSTS"
	fi
	if command -v setsid >/dev/null 2>&1; then
		setsid "$@" </dev/null >/dev/null 2>>"$ERRLOG" &
	elif command -v nohup >/dev/null 2>&1; then
		nohup "$@" </dev/null >/dev/null 2>>"$ERRLOG" &
	else
		"$@" </dev/null >/dev/null 2>>"$ERRLOG" &
	fi
	pid=$!
	sleep 1
	kill -0 "$pid" 2>/dev/null || { echo "Adaptive Controller не запустился."; return 1; }
	printf '%s\n' "$pid" >"$PIDFILE"
	chmod 600 "$PIDFILE" 2>/dev/null || :
	start_scheduler || return 1
	echo "Adaptive Controller запущен (PID $pid)."
}

stop_controller()
{
	stop_scheduler
	if ! controller_pid_valid; then
		rm -f "$PIDFILE"
		echo "Adaptive shadow не запущен."
		return 0
	fi
	pid=$(cat "$PIDFILE")
	kill -TERM "$pid" 2>/dev/null || :
	i=0
	while [ "$i" -lt 5 ] && kill -0 "$pid" 2>/dev/null; do
		sleep 1
		i=$((i + 1))
	done
	if kill -0 "$pid" 2>/dev/null; then kill -9 "$pid" 2>/dev/null || :; fi
	rm -f "$PIDFILE"
	echo "Adaptive Controller остановлен."
}

case "$1" in
	start) start_controller ;;
	stop) stop_controller ;;
	restart) stop_controller; start_controller ;;
	status)
		if controller_pid_valid; then echo "running (PID $(cat "$PIDFILE"))"; else echo stopped; fi
		;;
	*) echo "Usage: $0 {start|stop|restart|status}" >&2; exit 2 ;;
esac
