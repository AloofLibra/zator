#!/bin/sh

set -e

INSTALL_DIR="${Z2R_INSTALL_DIR:-/opt}"
LIB_FILES="ui.sh provider.sh telemetry.sh recommendations.sh netcheck.sh premium.sh strategies.sh submenus.sh actions.sh config.sh orchestra_state.sh"

fail() {
    echo "Ошибка: $*" >&2
    exit 1
}

launcher_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1

# После первой установки команда z2r продолжает работать как обычный launcher.
if [ ! -d "$launcher_dir/vendor" ]; then
    [ -f "$INSTALL_DIR/z2r.sh" ] || fail "не найден $INSTALL_DIR/z2r.sh"
    command -v bash >/dev/null 2>&1 || fail "bash не найден"
    [ -t 0 ] && exec bash "$INSTALL_DIR/z2r.sh" "$@"
    if ( : < /dev/tty ) 2>/dev/null; then
        exec bash "$INSTALL_DIR/z2r.sh" "$@" < /dev/tty
    else
        exec bash "$INSTALL_DIR/z2r.sh" "$@" < /dev/null
    fi
fi

BUNDLE_DIR="$launcher_dir"
PAYLOAD_DIR="$BUNDLE_DIR/payload"
VENDOR_DIR="$BUNDLE_DIR/vendor"

# Новый формат сборки: zator-<variant>.tar.gz (pack-zator-tar.mjs) рядом с
# vendor; старый — payload/ с деревом репо.
ZATOR_TAR=""
for f in "$BUNDLE_DIR"/zator-*.tar.gz; do
    [ -f "$f" ] && ZATOR_TAR="$f"
done

verify_bundle() {
    manifest="$BUNDLE_DIR/MANIFEST.files"
    [ -s "$manifest" ] || fail "в архиве отсутствует MANIFEST.files"
    while read -r expected_size rel; do
        case "$rel" in
            payload/*|vendor/*|zator-*.tar.gz|z2r|README.txt) ;;
            *) fail "некорректный путь в MANIFEST.files: $rel" ;;
        esac
        case "$rel" in
            /*|../*|*/../*|*/..) fail "небезопасный путь в MANIFEST.files: $rel" ;;
        esac
        [ -f "$BUNDLE_DIR/$rel" ] || fail "в архиве отсутствует $rel"
        actual_size=$(wc -c < "$BUNDLE_DIR/$rel" | tr -d '[:space:]') || \
            fail "не удалось проверить $rel"
        [ "$actual_size" = "$expected_size" ] || fail "размер файла не совпадает: $rel"
    done < "$manifest"
}

verify_bundle

ZAPRET2_VERSION=""
archive_count=0
for file in "$VENDOR_DIR"/zapret2-v*.tar.gz; do
    [ -f "$file" ] || continue
    name=${file##*/}
    case "$name" in
        zapret2-v*-openwrt-embedded.tar.gz)
            version=${name#zapret2-v}
            version=${version%-openwrt-embedded.tar.gz}
            ;;
        zapret2-v*.tar.gz)
            version=${name#zapret2-v}
            version=${version%.tar.gz}
            ;;
        *) continue ;;
    esac
    printf '%s\n' "$version" | grep -Eq '^[0-9]+(\.[0-9]+)*(-[A-Za-z0-9.-]+)?$' || \
        fail "некорректная версия zapret2 в имени $name"
    if [ -n "$ZAPRET2_VERSION" ] && [ "$version" != "$ZAPRET2_VERSION" ]; then
        fail "в vendor найдены разные версии zapret2"
    fi
    ZAPRET2_VERSION="$version"
    archive_count=$((archive_count + 1))
done
[ "$archive_count" -gt 0 ] || fail "в vendor отсутствует release-архив zapret2"
[ "$archive_count" -le 2 ] || fail "в vendor найдено слишком много release-архивов zapret2"

if [ -n "${Z2R_BIN_PATH:-}" ]; then
    BIN_PATH="$Z2R_BIN_PATH"
elif [ -d /opt/bin ]; then
    BIN_PATH="/opt/bin/z2r"
elif [ -d /usr/local/bin ] && [ -w /usr/local/bin ]; then
    BIN_PATH="/usr/local/bin/z2r"
elif [ -d /usr/bin ] && [ -w /usr/bin ]; then
    BIN_PATH="/usr/bin/z2r"
else
    fail "не найдено подходящее место для установки команды z2r"
fi

command -v bash >/dev/null 2>&1 || fail "bash не найден; установите bash до запуска архивной установки"

cp -f "$launcher_dir/z2r" "$BIN_PATH"
chmod +x "$BIN_PATH"

if [ -n "$ZATOR_TAR" ]; then
    stage_dir=$(mktemp -d "${TMPDIR:-/tmp}/z2r_offline.XXXXXX") || fail "не удалось создать временный каталог"
    tar -xzf "$ZATOR_TAR" -C "$stage_dir" z2r_lib/deploy.sh
    ZATOR_ROOT="$INSTALL_DIR/zator" \
    ZAPRET2_ROOT="$INSTALL_DIR/zapret2" \
    Z2R_SCRIPT_DEST="$INSTALL_DIR/z2r.sh" \
        bash "$stage_dir/z2r_lib/deploy.sh" from-tar "$ZATOR_TAR" full "offline-$ZAPRET2_VERSION"
    rm -rf "$stage_dir"
    [ -f "$INSTALL_DIR/z2r.sh" ] || fail "zator не развёрнут из архива"
    # оффлайн-сборка не проверяет и не качает обновления
    if [ ! -f "$INSTALL_DIR/z2r.conf" ]; then
        printf 'AUTOUPDATE=off\n' > "$INSTALL_DIR/z2r.conf"
    fi
    echo "Компоненты zator установлены из релизного архива."
else
    [ -f "$PAYLOAD_DIR/z2r.sh" ] || fail "в архиве отсутствует payload/z2r.sh"
    [ -f "$PAYLOAD_DIR/orchestra/locked.lua" ] || fail "в архиве отсутствует payload/orchestra/locked.lua"
    for file in $LIB_FILES; do
        [ -f "$PAYLOAD_DIR/lib/$file" ] || fail "в архиве отсутствует payload/lib/$file"
    done
    mkdir -p \
        "$INSTALL_DIR/zator/z2r_lib" \
        "$INSTALL_DIR/zator/extra_strats/cache/orchestra" \
        "$INSTALL_DIR/zator/lua"
    cp -f "$PAYLOAD_DIR/z2r.sh" "$INSTALL_DIR/z2r.sh"
    for file in $LIB_FILES; do
        cp -f "$PAYLOAD_DIR/lib/$file" "$INSTALL_DIR/zator/z2r_lib/$file"
    done
    cp -f "$PAYLOAD_DIR/orchestra/locked.lua" "$INSTALL_DIR/zator/lua/locked.lua"
    chmod +x "$INSTALL_DIR/z2r.sh"
    echo "Компоненты z2r установлены из архива."
    export Z2R_PROJECT_DIR="$PAYLOAD_DIR"
fi

export Z2R_OFFLINE=1
export ZAPRET2_ARCHIVE_DIR="$VENDOR_DIR"
export ZAPRET2_VERSION

if [ "${Z2R_NO_EXEC:-0}" = "1" ]; then
    echo "OFFLINE_READY version=$ZAPRET2_VERSION vendor=$ZAPRET2_ARCHIVE_DIR"
    exit 0
fi

[ -t 0 ] && exec bash "$INSTALL_DIR/z2r.sh" "$@"
if ( : < /dev/tty ) 2>/dev/null; then
    exec bash "$INSTALL_DIR/z2r.sh" "$@" < /dev/tty
else
    exec bash "$INSTALL_DIR/z2r.sh" "$@" < /dev/null
fi
